{
  "$schema": "https://calm.finos.org/release/1.0/meta/calm.json",
  "nodes": [
    {
      "unique-id": "trace-cli",
      "node-type": "service",
      "name": "The command",
      "description": "railyard-trace: backward, forward, index and stamp, and how each answer is printed.",
      "source-path": "traceability/cli.ts"
    },
    {
      "unique-id": "trace-library",
      "node-type": "service",
      "name": "The library surface",
      "description": "What the package exports for another tool to call. Nothing else in traceability is public.",
      "source-path": "traceability/index.ts"
    },
    {
      "unique-id": "query",
      "node-type": "service",
      "name": "Queries",
      "description": "Backward from a position to the artifacts that caused it, forward from an artifact to every position that traces to it, and the whole-tree trace an index is written from.",
      "source-path": "traceability/query.ts"
    },
    {
      "unique-id": "indexing",
      "node-type": "service",
      "name": "Indexing",
      "description": "Writes one commit's links into a symbols directory, as a new version against the one before it.",
      "source-path": "traceability/indexing.ts"
    },
    {
      "unique-id": "symbols-format",
      "node-type": "data-asset",
      "name": "The symbols format",
      "description": "The symbols directory's record: the shared index, one file per version, and the anchors that name what a position is. Read and written only here.",
      "source-path": [
        "traceability/symbols.ts",
        "traceability/anchor.ts"
      ]
    },
    {
      "unique-id": "lookup",
      "node-type": "service",
      "name": "Lookup",
      "description": "Answers from a symbols directory alone, with no repository and no git: a built file's position, taken back through its source map.",
      "source-path": "traceability/lookup.ts"
    },
    {
      "unique-id": "build-hash",
      "node-type": "service",
      "name": "Build hash",
      "description": "The hash a build carries so its symbols can be found, and the stamp that writes it into a page, a script or a source map.",
      "source-path": "traceability/build-hash.ts"
    },
    {
      "unique-id": "source-map",
      "node-type": "service",
      "name": "Source maps",
      "description": "Reads the source maps a build already makes, from a position in what was built back to a position in its source.",
      "source-path": "traceability/source-map.ts"
    },
    {
      "unique-id": "adapters",
      "node-type": "service",
      "name": "Adapters",
      "description": "What a repository's artifacts are and how they are cited: its specs, criteria, waymarks and tests tables, and its CALM models and their source paths.",
      "source-path": [
        "traceability/railyard-adapter.ts",
        "traceability/calm-adapter.ts"
      ]
    },
    {
      "unique-id": "scope",
      "node-type": "service",
      "name": "Scope",
      "description": "Which comments apply to a line, and which text of a line is comment and can cite. One textual rule for every language.",
      "source-path": "traceability/scope.ts"
    },
    {
      "unique-id": "git-reader",
      "node-type": "service",
      "name": "Git reader",
      "description": "The only code that runs a process: git, read-only, hardened, with an environment of its own.",
      "source-path": "traceability/git.ts"
    },
    {
      "unique-id": "render",
      "node-type": "service",
      "name": "Rendering",
      "description": "Turns an answer into the text a person reads.",
      "source-path": "traceability/render.ts"
    },
    {
      "unique-id": "trace-model",
      "node-type": "data-asset",
      "name": "Shared types",
      "description": "The types every part shares: artifacts, links and how each is known, positions, versions and refusals.",
      "source-path": "traceability/model.ts"
    }
  ],
